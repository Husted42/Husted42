[theme]
base = "dark"

# Main colors
primaryColor = "#3B82F6"
backgroundColor = "#0B0F19"
secondaryBackgroundColor = "#1E293B"
textColor = "#F1F5F9"

# UI styling
borderColor = "#334155"
baseRadius = "0.5rem"
showWidgetBorder = true
showSidebarBorder = true

# Typography
font = "sans serif"

# Charts
chartCategoricalColors = [
    "#3B82F6",
    "#60A5FA",
    "#1D4ED8",
    "#93C5FD",
    "#2563EB",
    "#06B6D4"
]

[theme.sidebar]
backgroundColor = "#111827"
secondaryBackgroundColor = "#1E293B"
textColor = "#F1F5F9"
primaryColor = "#3B82F6"