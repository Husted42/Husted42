general {
    colors = true
    interval = 1
    separator = " | "
    color_good = "#7dd3fc"
    color_degraded = "#fbbf24"
    color_bad = "#f87171"
}

order += "volume master"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "cpu_usage"
order += "memory"
order += "disk /"
order += "disk /home"
order += "time"

volume master {
    device = "default"
    mixer = "Master"
    mixer_idx = 0
    format = "VOL %volume"
    format_muted = "VOL MUTE"
}

wireless _first_ {
    format_up = "WIFI %quality %essid %ip"
    format_down = "WIFI OFF"
}

battery all {
    format = "BAT %percentage"
    status_chr = "CHR"
    status_bat = "BAT"
    status_unk = "UNK"
    status_full = "FULL"

    low_threshold = 20
    threshold_type = percentage
    integer_battery_capacity = true
    last_full_capacity = true
    hide_seconds = true
}

time {
    format = "%Y-%m-%d %H:%M:%S"
}

load {
    format = "LOAD %1min"
}

disk "/" {
    format = "NVME %avail"
    prefix_type = custom
    low_threshold = 15
    threshold_type = percentage_avail
}

cpu_usage {
    format = "CPU %usage"
}

memory {
    format = "RAM %used"
}