[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 140
    offset = 20x44
    origin = top-right
    scale = 0
    notification_limit = 8
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 160
    progress_bar_max_width = 300
    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 2
    frame_color = "#2563eb"
    separator_color = "#1d4ed8"
    sort = yes
    idle_threshold = 120
    font = DejaVu Sans Mono 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 20
    max_icon_size = 44
    sticky_history = yes
    history_length = 30
    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 6
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#020409"
    foreground = "#8fd3ff"
    timeout = 4

[urgency_normal]
    background = "#07131f"
    foreground = "#bfe8ff"
    timeout = 7

[urgency_critical]
    background = "#2f0b14"
    foreground = "#fca5a5"
    frame_color = "#ef4444"
    timeout = 0
